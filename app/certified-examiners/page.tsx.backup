'use client';

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import Link from "next/link";

import "@/styles/cta-shared.css";
import "./page.css";

import { ExaminerAdminPanel } from "@/components/examiners/ExaminerAdminPanel";
import { ExaminerCard } from "@/components/examiners/ExaminerCard";
import { ExaminerCardSkeleton } from "@/components/examiners/ExaminerCardSkeleton";
import type {
  ExaminerAdminPanelHandle,
  ExaminerProfile,
} from "@/components/examiners/examinerTypes";

const INITIAL_VISIBLE_COUNT = 9;

const CATEGORY_ORDER = [
  "funding",
  "certification",
  "export",
  "manufacturing",
  "startup",
  "general",
] as const;

const CATEGORY_LABELS: Record<string, string> = {
  all: "전체",
  funding: "정책자금",
  certification: "인증",
  export: "수출",
  manufacturing: "제조혁신",
  startup: "창업",
  general: "기타",
};

const heroStats = [
  { value: "1,284+", label: "누적 컨설팅" },
  { value: "97%", label: "상담 만족도" },
  { value: "72명", label: "활동 중 심사관" },
];

const GENERAL_CATEGORY = "general";

const getCategoryValue = (rawCategory?: string | null) => {
  if (typeof rawCategory === "string" && rawCategory.trim()) {
    return rawCategory.trim();
  }
  return GENERAL_CATEGORY;
};

const shuffle = <T,>(items: T[]): T[] => {
  const next = [...items];
  for (let index = next.length - 1; index > 0; index -= 1) {
    const swapIndex = Math.floor(Math.random() * (index + 1));
    [next[index], next[swapIndex]] = [next[swapIndex], next[index]];
  }
  return next;
};

export default function CertifiedExaminersPage() {
  const adminPanelRef = useRef<ExaminerAdminPanelHandle | null>(null);
  const [examiners, setExaminers] = useState<ExaminerProfile[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [fetchError, setFetchError] = useState<string | null>(null);
  const [activeCategory, setActiveCategory] = useState<string>("all");
  const [expanded, setExpanded] = useState(false);

  const fetchExaminers = useCallback(async () => {
    try {
      setIsLoading(true);
      setFetchError(null);
      const response = await fetch("/api/expert-services/examiners", {
        cache: "force-cache",
        next: { revalidate: 60 },
      });

      if (!response.ok) {
        throw new Error(
          `인증 기업심사관 정보를 불러오지 못했습니다. (Status: ${response.status})`,
        );
      }

      const data = await response.json().catch(() => null);
      const list = Array.isArray(data?.examiners)
        ? (data.examiners as ExaminerProfile[])
        : [];
      setExaminers(list);
    } catch (error) {
      console.error("[CertifiedExaminers] fetch", error);
      setExaminers([]);
      setFetchError(
        error instanceof Error
          ? error.message
          : "인증 기업심사관 정보를 불러오지 못했습니다.",
      );
    } finally {
      setIsLoading(false);
    }
  }, []);

  useEffect(() => {
    void fetchExaminers();
  }, [fetchExaminers]);

  const shuffledExaminers = useMemo(() => shuffle(examiners), [examiners]);

  const categories = useMemo(() => {
    const dataset = Array.from(
      new Set(shuffledExaminers.map((examiner) => getCategoryValue(examiner.category))),
    );
    const ordered = CATEGORY_ORDER.filter((category) => dataset.includes(category));
    const fallback = dataset.filter(
      (category) => !CATEGORY_ORDER.includes(category as (typeof CATEGORY_ORDER)[number]),
    );
    return ["all", ...ordered, ...fallback];
  }, [shuffledExaminers]);

  useEffect(() => {
    if (activeCategory !== "all" && !categories.includes(activeCategory)) {
      setActiveCategory("all");
      setExpanded(false);
    }
  }, [activeCategory, categories]);

  const filteredExaminers = useMemo(() => {
    if (activeCategory === "all") {
      return shuffledExaminers;
    }
    return shuffledExaminers.filter(
      (examiner) => getCategoryValue(examiner.category) === activeCategory,
    );
  }, [activeCategory, shuffledExaminers]);

  const visibleExaminers =
    activeCategory === "all" && !expanded
      ? filteredExaminers.slice(0, INITIAL_VISIBLE_COUNT)
      : filteredExaminers;

  const remainingCount =
    activeCategory === "all"
      ? Math.max(filteredExaminers.length - visibleExaminers.length, 0)
      : 0;

  const handleCategoryChange = (category: string) => {
    setActiveCategory(category);
    setExpanded(false);
  };

  const handleRefreshPublished = useCallback(async () => {
    await fetchExaminers();
  }, [fetchExaminers]);

  const handleOpenAdminPanel = () => {
    adminPanelRef.current?.openModal();
  };

  return (
    <div className="certified-examiners">
      <section className="certified-examiners__hero">
        <div className="certified-examiners__container">
          <div className="certified-examiners__hero-content">
            <span className="certified-examiners__hero-badge">
              <i className="fas fa-shield-check" aria-hidden="true" /> 프리미엄 인증 기업심사관
            </span>
            <h1 className="certified-examiners__hero-title">
              검증된 전문가와 완성하는
              <span className="certified-examiners__hero-highlight">
                하이엔드 정책자금 파트너십
              </span>
            </h1>
            <p className="certified-examiners__hero-description">
              나라돈이 직접 보증하는 인증 기업심사관들이 전략 수립부터 서류 준비, 현장 대응까지
              전 과정을 케어합니다. 블랙 &amp; 골드 테마로 새로워진 프리미엄 경험을 만나보세요.
            </p>
            <p className="certified-examiners__hero-subtext">
              고도화된 검증 시스템으로 선발된 심사관이 분야별 맞춤형 컨설팅을 제공합니다.
            </p>
            <div className="certified-examiners__hero-footer">
              <div className="certified-examiners__hero-stats">
                {heroStats.map((stat) => (
                  <div className="certified-examiners__hero-stat-card" key={stat.label}>
                    <span className="certified-examiners__hero-stat-value">{stat.value}</span>
                    <span className="certified-examiners__hero-stat-label">{stat.label}</span>
                  </div>
                ))}
              </div>
              <Link
                href="/consultation-request#form-section"
                className="certified-examiners__hero-cta"
              >
                <span>프리미엄 상담 예약</span>
                <i className="fas fa-arrow-right" aria-hidden="true" />
              </Link>
            </div>
          </div>
        </div>
      </section>

      <section className="certified-examiners__section">
        <div className="certified-examiners__container">
          <div className="certified-examiners__section-header">
            <span className="certified-examiners__section-eyebrow">CURATED ADVISORS</span>
            <h2 className="certified-examiners__section-title">인증 기업심사관 디렉터리</h2>
            <p className="certified-examiners__section-description">
              정책자금·인증·수출·제조혁신 등 핵심 영역별로 검증된 심사관을 선택해
              상담을 진행해 보세요. 모든 심사관은 정기적인 품질 평가와 실적 검증을 통과했습니다.
            </p>
          </div>

          <div className="certified-examiners__category-list">
            {categories.map((category) => {
              const isActive = activeCategory === category;
              const label = CATEGORY_LABELS[category] ?? category;
              return (
                <button
                  key={category}
                  type="button"
                  className={
                    isActive
                      ? "certified-examiners__category-button is-active"
                      : "certified-examiners__category-button"
                  }
                  onClick={() => handleCategoryChange(category)}
                  aria-pressed={isActive}
                >
                  {label}
                </button>
              );
            })}
          </div>

          {isLoading && (
            <div className="certified-examiners__directory-grid">
              {Array.from({ length: INITIAL_VISIBLE_COUNT }, (_, index) => (
                <ExaminerCardSkeleton key={`skeleton-${index}`} />
              ))}
            </div>
          )}

          {fetchError ? (
            <p className="certified-examiners__status-message">{fetchError}</p>
          ) : null}

          {!isLoading && !fetchError && filteredExaminers.length === 0 ? (
            <p className="certified-examiners__status-empty">
              아직 등록된 인증 기업심사관이 없습니다. 곧 새로운 전문가 정보를 소개해 드릴게요.
            </p>
          ) : null}

          {!isLoading && filteredExaminers.length > 0 && (
            <div className="certified-examiners__directory-grid">
              {visibleExaminers.map((examiner, index) => {
                const key = examiner._id ?? `${examiner.name}-${index}`;
                return (
                  <ExaminerCard
                    key={key}
                    examiner={examiner}
                    priority={index < 3}
                  />
                );
              })}
            </div>
          )}

          <div className="certified-examiners__admin-action">
            <button type="button" onClick={handleOpenAdminPanel}>
              인증 기업심사관 관리 패널 열기
            </button>
          </div>

          {activeCategory === "all" && !expanded && remainingCount > 0 ? (
            <div className="certified-examiners__load-more">
              <button
                type="button"
                className="certified-examiners__load-more-button"
                onClick={() => setExpanded(true)}
              >
                더 많은 전문가 보기 ({remainingCount})
              </button>
            </div>
          ) : null}

          <div className="certified-examiners__cta-section">
            <div className="certified-examiners__cta-banner">
              <div className="certified-examiners__cta-content">
                <span className="certified-examiners__cta-eyebrow">PREMIUM CONSULTING</span>
                <h3 className="certified-examiners__cta-title">
                  나라돈 전담 심사관과 함께하는
                  <br /> 맞춤형 자금 전략 세션
                </h3>
                <p className="certified-examiners__cta-subtitle">
                  상담신청을 남겨주시면 24시간 이내에 전담 심사관이 연락드려 프로젝트 진단과
                  즉시 실행 가능한 솔루션을 제안해 드립니다.
                </p>
              </div>
              <Link href="/consultation-request#form-section" className="certified-examiners__cta-button">
                컨설팅 신청하기
                <i className="fas fa-arrow-right" aria-hidden="true" />
              </Link>
            </div>
          </div>
        </div>
      </section>

      <ExaminerAdminPanel
        ref={adminPanelRef}
        onRefreshPublished={handleRefreshPublished}
      />
    </div>
  );
}
