{
  "name": "naraddon-nextjs",
  "version": "0.1.6",
  "private": true,
  "scripts": {
    "migrate:ttontok-categories:fallback": "ts-node --transpile-only --compiler-options {\"module\":\"commonjs\"} scripts/migrate-ttontok-categories.ts --apply --fallback-etc",
    "backup:list": "node scripts/backup.js list",
    "backup:consult-sections": "node scripts/backup-consultation-sections.js",
    "deploy": "npm run backup:full && vercel --prod",
    "commit:history": "node scripts/commit-tracker.js history",
    "backup:component": "node scripts/backup.js component",
    "backup": "node scripts/backup.js",
    "dev:8080": "next dev -p 8080",
    "migrate:ttontok-categories:apply": "ts-node --transpile-only --compiler-options {\"module\":\"commonjs\"} scripts/migrate-ttontok-categories.ts --apply",
    "backup:status": "node scripts/backup.js status",
    "seed:experts": "node scripts/seed-expert-examiners.js",
    "preflight": "powershell -ExecutionPolicy Bypass -File tools/preflight.ps1",
    "backup:full": "node scripts/backup.js full",
    "backup:milestone": "node scripts/backup.js milestone",
    "seed:ttontok": "ts-node --transpile-only scripts/seed-ttontok.ts",
    "seed:rbac": "ts-node --transpile-only scripts/seed-rbac.ts",
    "test:rbac": "ts-node --transpile-only scripts/test-rbac.ts",
    "check:users": "ts-node --transpile-only scripts/check-users.ts",
    "create:indexes": "npx tsx scripts/create-rbac-indexes.ts",
    "dev:3002": "next dev -p 3002",
    "dev": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" next dev",
    "lint": "next lint",
    "notion:upload": "node scripts/upload-to-notion.js",
    "notion:plan": "node scripts/upload-to-notion.js docs/admin-architecture-plan.md",
    "release": "npm run backup:full && npm run preflight && vercel deploy --prod",
    "start": "next start",
    "deploy:all": "npm run backup:full && npm run preflight && vercel --prod",
    "dev:3001": "powershell -ExecutionPolicy Bypass -File scripts/kill-port.ps1 3001 && next dev -p 3001",
    "commit:restore": "node scripts/commit-tracker.js restore",
    "migrate:ttontok-categories": "ts-node --transpile-only --compiler-options {\"module\":\"commonjs\"} scripts/migrate-ttontok-categories.ts",
    "commit:stats": "node scripts/commit-tracker.js stats",
    "commit:cleanup": "node scripts/commit-tracker.js cleanup",
    "build": "next build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "logs:cloudflare": "pwsh -ExecutionPolicy Bypass -File scripts/cloudflare-tail.ps1",
    "watch:tasks": "node scripts/watch-tasks.js",
    "watch:reviews": "node scripts/watch-reviews.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.893.0",
    "@aws-sdk/s3-request-presigner": "^3.892.0",
    "@heroicons/react": "^2.2.0",
    "@next-auth/mongodb-adapter": "^1.1.3",
    "@notionhq/client": "^5.1.0",
    "@replayio/replay": "^0.22.12",
    "@sentry/integrations": "^7.114.0",
    "@sentry/nextjs": "^10.17.0",
    "@tremor/react": "^3.18.7",
    "@types/bcrypt": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.0",
    "dotenv": "^17.2.2",
    "framer-motion": "^11.0.3",
    "fs-extra": "^11.3.2",
    "logrocket": "^10.1.0",
    "mongoose": "^8.18.1",
    "next": "14.1.0",
    "next-auth": "^4.24.11",
    "openai": "^6.1.0",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.5.0",
    "react-quill": "^2.0.0",
    "recharts": "^3.2.1",
    "swiper": "^12.0.2",
    "tailwind-merge": "^2.2.0",
    "ua-parser-js": "^2.0.5",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.10.1",
    "@playwright/test": "^1.55.0",
    "@prisma/client": "^6.16.2",
    "@storybook/nextjs": "^9.1.7",
    "@storybook/react": "^9.1.7",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/xlsx": "^0.0.35",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.0.1",
    "chokidar": "^4.0.3",
    "cross-env": "^10.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.1.6",
    "png-to-ico": "^3.0.1",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "puppeteer": "^23.11.1",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "wrangler": "^4.38.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
