# Cloudflare R2 Storage
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_access_key
CLOUDFLARE_R2_BUCKET=naraddon-assets
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-your_hash.r2.dev

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Service Passwords (Server-only - Never use NEXT_PUBLIC_ prefix)
NARADDON_TUBE_PASSWORD=your_password
QA_WRITE_PASSWORD=your_password
TTONTOK_WRITE_PASSWORD=your_password
EXPERT_SERVICES_PASSWORD=your_password
BUSINESS_VOICE_INTERVIEW_PASSWORD=your_password
POLICY_ANALYSIS_PASSWORD=your_password
POLICY_NEWS_PASSWORD=your_password

# NextAuth
NEXTAUTH_SECRET=your_secret_key
NEXTAUTH_URL=https://naraddon.com

# Social Login - Naver
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Social Login - Kakao (Optional)
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Notion (Optional)
NOTION_API_KEY=your_notion_api_key

# Telegram (Optional)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Data.go.kr API (Business Verification)
DATA_GO_KR_API_KEY=your_data_go_kr_api_key
# Sentry Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAYS_ERROR_SAMPLE_RATE=1
SENTRY_DRY_RUN=0
SENTRY_DEBUG=0

# LogRocket (Optional)
NEXT_PUBLIC_LOGROCKET_APP_ID=
NEXT_PUBLIC_LOGROCKET_ENABLED=true
NEXT_PUBLIC_LOGROCKET_RELEASE=

# Replay.io (Optional)
NEXT_PUBLIC_REPLAY_IO_API_KEY=
NEXT_PUBLIC_REPLAY_IO_ENABLED=false
